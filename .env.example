# Copie para .env antes de subir o banco:  cp .env.example .env
# Todos os valores abaixo são fictícios e servem apenas ao ambiente local.

POSTGRES_USER=tuning
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_DB=tuning_lab
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# Volume de dados gerado pelo comando "preparar".
# Reduza se a máquina for modesta; aumente para ver a diferença dos índices crescer.
QTD_CLIENTES=20000
QTD_PRODUTOS=2000
QTD_PEDIDOS=300000
